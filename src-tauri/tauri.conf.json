{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Coding Agent",
  "version": "1.7.1",
  "identifier": "com.codingagent.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1422",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Coding Agent",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "decorations": false,
        "backgroundThrottling": "disabled"
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": {
        "default-src": ["'none'"],
        "object-src": ["'none'"],
        "base-uri": ["'none'"],
        "form-action": ["'none'"],
        "frame-ancestors": ["'none'"],
        "script-src": ["'self'", "coding-agent-plugin:", "http://coding-agent-plugin.localhost"],
        "style-src": [
          "'self'",
          "'unsafe-inline'",
          "coding-agent-plugin:",
          "http://coding-agent-plugin.localhost"
        ],
        "img-src": [
          "'self'",
          "data:",
          "asset:",
          "http://asset.localhost",
          "coding-agent-plugin:",
          "http://coding-agent-plugin.localhost",
          "http:",
          "https:"
        ],
        "media-src": ["'self'", "asset:", "http://asset.localhost", "mediastream:", "blob:"],
        "font-src": ["'self'", "coding-agent-plugin:", "http://coding-agent-plugin.localhost"],
        "connect-src": [
          "'self'",
          "ipc:",
          "http://ipc.localhost",
          "https://registry.npmjs.org",
          "https://api.github.com"
        ],
        "worker-src": ["'none'"],
        "frame-src": ["asset:", "http://asset.localhost", "http:", "https:"]
      },
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "publisher": "Coding Agent contributors",
    "shortDescription": "Multi-agent coding workspace",
    "longDescription": "Coding Agent is a local workspace for running Claude Code, Codex and other coding agents side by side, with Coding Opus orchestration and memory. Based on Alethe by Kauã Miguel (AGPL-3.0-or-later).",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdERjQwQTVDMDJFMDY3QzQKUldURVorQUNYQXIwZlpTZjNhc1dNamhiSERnalducjJCdDdiR0NFYy8ydnJqcU52VG05cFNqcHUK",
      "endpoints": [
        "https://github.com/oigorbrazil/coding-agent/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
